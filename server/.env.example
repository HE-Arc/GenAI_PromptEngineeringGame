# Direct OpenAI path (alternative to the endpoint below): set the key and
# unset LLM_BASE_URL. One of the two key options is required.
#OPENAI_API_KEY=sk-...
# OpenCode Go gateway (OpenAI-compatible): key from https://opencode.ai/auth
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=sk-...
LLM_MODEL=muse-spark-1.3-contributor
# The judge grades every answer at the end of the round, and it gets its own
# variable on purpose: it is the call you want to be able to move to a bigger
# model on a day when a group's scores look wrong, without touching the call
# that sits on the critical path of every round.
JUDGE_MODEL=muse-spark-1.3-contributor
# LLM timeouts: no env knob in this build; the values are fixed in code
# (ws idle 45s in server/src/ws/mod.rs, sqlite busy 5s in
# server/src/db/mod.rs). Kept here so the next person knows where to look.
#ADMIN_PASSWORD is the teacher password checked by /api/admin/login.
ADMIN_PASSWORD=genai
# Optional: signs the admin session cookie. Unset = a fresh random key is
# generated per server start (every restart signs admins out). Set it when
# several server replicas must accept each other's sessions: generate once
# with `openssl rand -hex 32` and give every replica the SAME value
# (docker-compose.yml already forwards ${ADMIN_SECRET} into the server).
#ADMIN_SECRET=replace-with-openssl-rand-hex-32
# SQLite file. Inside Docker the image defaults to
# sqlite:/data/server.sqlite3?mode=rwc (whole /data dir on the named volume
# so -wal/-shm survive restarts). Set this only for local dev layouts.
#DATABASE_URL=sqlite:server.sqlite3?mode=rwc
# Log filter (tracing_env_filter syntax): info default, debug for per-request
# traces, warn in production when the volume gets noisy.
RUST_LOG=info
# Port the server listens on; must match the publish entry in
# docker-compose.yml (3001:3001) and the Dockerfile CMD (--port 3001).
PORT=3001
