# Direct OpenAI path (alternative to the endpoint below): set the key and
# unset LLM_BASE_URL. One of the two key options is required.
#OPENAI_API_KEY=sk-...
# OpenCode Go gateway (OpenAI-compatible): key from https://opencode.ai/auth
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=sk-...
LLM_MODEL=opencode/muse-spark-1.3-contributor-free
# The judge grades every answer at the end of the round, and it gets its own
# variable on purpose: it is the call you want to be able to move to a bigger
# model on a day when a group's scores look wrong, without touching the call
# that sits on the critical path of every round.
JUDGE_MODEL=opencode/muse-spark-1.3-contributor-free
ADMIN_PASSWORD=genai
# Optional: signs the admin session cookie. Unset = a fresh random key is
# generated per server start (every restart signs admins out). Set it only
# when several server replicas must accept each other's sessions.
# ADMIN_SECRET=
DATABASE_URL=sqlite:server.sqlite3?mode=rwc
