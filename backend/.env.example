OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini
# The critic is the arbiter of the cross-rating, and it gets its own variable on purpose: it is
# the call you want to be able to move to a bigger model on a day when a group's scores look
# wrong, without touching the two calls that sit on the critical path of every round.
CRITIC_MODEL=gpt-4o-mini
ADMIN_PASSWORD=genai
# MUST be changed for anything but local play. Sessions are signed cookies and there is no
# server-side session state, so SECRET_KEY alone decides who is admin: anyone holding the
# default can forge {"admin": true}, and a forged session cannot be revoked.
SECRET_KEY=dev-only-insecure
