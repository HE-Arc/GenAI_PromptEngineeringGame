# OpenCode Go gateway
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=sk-...
LLM_MODEL=muse-spark-1.3-contributor

# Judge grades every answer at round end.
JUDGE_MODEL=muse-spark-1.3-contributor

# Teacher password checked by /api/admin/login.
ADMIN_PASSWORD=genai
# Optional: signs the admin session cookie.
#ADMIN_SECRET=replace-with-openssl-rand-hex-32

# SQLite file.
#DATABASE_URL=sqlite:server.sqlite3?mode=rwc

# Log filter
RUST_LOG=info
# Port the server listens on
PORT=3001

# Logs : niveau (error|warn|info|debug, ex. "info,server::ws=debug") et format (text|json)
RUST_LOG=info
LOG_FORMAT=text
